module BitClust
  module Subcommands
    class ExtractCommand < Subcommand
      @check_only: true?

      def initialize: () -> void

      def needs_database?: () -> bool

      def exec: (Subcommand::argv argv, Subcommand::options options) -> void

      def reject_markdown_source: (String path) -> void

      def show_library: (LibraryEntry lib) -> void
    end
  end
end
