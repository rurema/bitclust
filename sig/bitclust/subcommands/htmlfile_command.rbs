module BitClust
  module Subcommands
    class HtmlfileCommand < Subcommand
      @target: String

      @library: String?

      @templatedir: Pathname | String

      @baseurl: String

      @version: String

      @capi: bool

      @rd_file: bool?

      def initialize: () -> void

      def needs_database?: () -> bool

      def exec: (Subcommand::argv argv, Subcommand::options options) -> void

      private

      def exec_markdown: (String path, MethodDatabase? real_db) -> void

      def markdown_doc_entry: (MethodDatabase db, String path, Database::database_properties props) -> DocEntry

      def markdown_libname: (MethodDatabase db, String path) -> String

      def lookup: (Array[FunctionEntry] | LibraryEntry lib, String key) -> (FunctionEntry | ClassEntry | Array[MethodEntry] | bot)
    end
  end
end
